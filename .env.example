# OpenRouter (gateway único de modelos)
OPENROUTER_API_KEY=sk-or-v1-...

# Puertos locales (bind a 127.0.0.1)
OPENCODE_PORT=4096
ORCH_REST_PORT=8787
ORCH_WS_PORT=8788
DASHBOARD_PORT=4200

# OpenCode server (defensa en profundidad, aunque sea local)
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=cambia-esto

# NATS
NATS_URL=nats://broker:4222

# Postgres
POSTGRES_USER=own_ia
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=own_ia
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Raíz de proyectos reales montada en los contenedores (carpetas/repos de trabajo)
PROJECTS_ROOT=/home/javi/proyects_ia

# --- Motor Kiro CLI (opcional, profile "kiro") ---
# Carpeta del host con los binarios de kiro-cli (se montan en solo lectura en el contenedor)
# KIRO_BIN_DIR=/home/tu-usuario/.local/bin
# Alternativa al login por device flow (make kiro-login): autenticación headless
# KIRO_API_KEY=

# Usuario del host dueño de PROJECTS_ROOT (salida de `id -u` / `id -g`).
# Los agentes escriben como root; el orquestador devuelve la propiedad a este usuario.
PROJECTS_UID=1000
PROJECTS_GID=1000
# Vigilante de comandos del motor Kiro y tope por turno (ms)
# RUNNER_CMD_TIMEOUT_MS=300000
# KIRO_TURN_TIMEOUT_MS=1800000
