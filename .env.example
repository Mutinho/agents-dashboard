# OpenRouter (gateway único de modelos)
OPENROUTER_API_KEY=sk-or-v1-...

# Puertos locales (bind a 127.0.0.1)
OPENCODE_PORT=4096
ORCH_REST_PORT=8787
ORCH_WS_PORT=8788
DASHBOARD_PORT=4200

# OpenCode server (defensa en profundidad, aunque sea local)
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=cambia-esto

# NATS
NATS_URL=nats://broker:4222

# Postgres
POSTGRES_USER=own_ia
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=own_ia
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Raíz de proyectos reales montada en los contenedores (carpetas/repos de trabajo)
PROJECTS_ROOT=/home/javi/proyects_ia
